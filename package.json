{
  "name": "fh6-pitwall",
  "version": "0.1.0",
  "description": "A real-time telemetry dashboard for Forza Horizon 6.",
  "author": "Kevin From <software@fromsoftware.dk>",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron:dev": "nuxt build && electron .",
    "electron:build": "nuxt build && electron-builder --win portable",
    "dist": "npm run electron:build"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "eslint": "^10.4.1",
    "nuxt": "^4.4.7",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dk.fromsoftware.fh6pitwall",
    "productName": "FH6 Pitwall",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": "output"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "FH6-Pitwall-${version}.exe"
    }
  }
}
